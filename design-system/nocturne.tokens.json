        "$value": "#F2C66D",
        "$type": "color"
      }
    },
    "status": {
      "error": {
        "$value": "#FF8A8A",
        "$type": "color"
      },
      "success": {
        "$value": "#6EE7B7",
        "$type": "color"
      },
      "warning": {
        "$value": "#FFD27A",
        "$type": "color"
      }
    },
    "border": {
      "hairline": {
        "$value": "#A99BFF",
        "$type": "color"
      }
    },
    "focus": {
      "ring": {
        "$value": "#F2C66D",
        "$type": "color"
      }
    },
    "palm": {
      "heart": {
        "$value": "#FF7A9A",
        "$type": "color"
      },
      "head": {
        "$value": "#7CC4FF",
        "$type": "color"
      },
      "life": {
        "$value": "#6EE7B7",
        "$type": "color"
      },
      "fate": {
        "$value": "#F2C66D",
        "$type": "color"
      },
      "sun": {
        "$value": "#FFA94D",
        "$type": "color"
      }
    },
    "ad": {
      "outline": {
        "$value": "#B4ACDB",
        "$type": "color"
      }
    }
