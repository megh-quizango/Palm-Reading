  "dimension": {
    "space": {
      "2": {
        "$value": "2px",
        "$type": "dimension"
      },
      "4": {
        "$value": "4px",
        "$type": "dimension"
      },
      "8": {
        "$value": "8px",
        "$type": "dimension"
      },
      "12": {
        "$value": "12px",
        "$type": "dimension"
      },
      "16": {
        "$value": "16px",
        "$type": "dimension"
      },
      "20": {
        "$value": "20px",
        "$type": "dimension"
      },
      "24": {
        "$value": "24px",
        "$type": "dimension"
      },
      "32": {
        "$value": "32px",
        "$type": "dimension"
      },
      "48": {
        "$value": "48px",
        "$type": "dimension"
      }
    },
    "radius": {
      "xs": {
        "$value": "4px",
        "$type": "dimension"
      },
      "sm": {
        "$value": "8px",
        "$type": "dimension"
      },
      "md": {
        "$value": "16px",
        "$type": "dimension"
      },
      "lg": {
        "$value": "24px",
        "$type": "dimension"
      },
      "xl": {
        "$value": "32px",
        "$type": "dimension"
      },
      "pill": {
        "$value": "999px",
        "$type": "dimension"
      }
    },
    "size": {
      "touch-min": {
        "$value": "48px",
        "$type": "dimension"
      },
      "button": {
        "$value": "52px",
        "$type": "dimension"
      },
      "icon": {
        "$value": "24px",
        "$type": "dimension"
      }
    }
  },
  "font": {
    "family": {
      "display": {
        "$value": "Cormorant Garamond",
        "$type": "fontFamily"
      },
      "ui": {
        "$value": "Manrope",
        "$type": "fontFamily"
      }
    }
  },
  "typography": {
    "Display": {
      "XL": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.display}",
          "fontWeight": 600,
          "fontSize": "40px",
          "lineHeight": "44px",
          "letterSpacing": "0.00em"
        }
      },
      "L": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.display}",
          "fontWeight": 600,
          "fontSize": "32px",
          "lineHeight": "38px",
          "letterSpacing": "0.00em"
        }
      },
      "M": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.display}",
          "fontWeight": 600,
          "fontSize": "26px",
          "lineHeight": "32px",
          "letterSpacing": "0.00em"
        }
      },
      "S": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.display}",
          "fontWeight": 600,
          "fontSize": "22px",
          "lineHeight": "28px",
          "letterSpacing": "0.00em"
        }
      }
    },
    "Title": {
      "M": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.ui}",
          "fontWeight": 700,
          "fontSize": "17px",
          "lineHeight": "24px",
          "letterSpacing": "0.00em"
        }
      }
    },
    "Body": {
      "L": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.ui}",
          "fontWeight": 500,
          "fontSize": "15px",
          "lineHeight": "22px",
          "letterSpacing": "0.00em"
        }
      },
      "M": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.ui}",
          "fontWeight": 400,
          "fontSize": "14px",
          "lineHeight": "20px",
          "letterSpacing": "0.00em"
        }
      }
    },
    "Label": {
      "L": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.ui}",
          "fontWeight": 700,
          "fontSize": "16px",
          "lineHeight": "20px",
          "letterSpacing": "0.00em"
        }
      },
      "M": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.ui}",
          "fontWeight": 600,
          "fontSize": "13px",
          "lineHeight": "18px",
          "letterSpacing": "0.00em"
        }
      }
    },
    "Caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.ui}",
        "fontWeight": 400,
        "fontSize": "12px",
        "lineHeight": "16px",
        "letterSpacing": "0.00em"
      }
    },
    "Overline": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.ui}",
        "fontWeight": 700,
        "fontSize": "12px",
        "lineHeight": "16px",
        "letterSpacing": "0.12em"
      }
    }
  },
  "shadow": {
    "Glow": {
      "Primary": {
        "$type": "shadow",
        "$value": {
          "color": "#6A4CF573",
          "offsetX": "0px",
          "offsetY": "8px",
          "blur": "24px",
          "spread": "0px"
        }
      },
      "Card": {
        "$type": "shadow",
        "$value": {
          "color": "#6A4CF538",
          "offsetX": "0px",
          "offsetY": "8px",
          "blur": "28px",
          "spread": "0px"
        }
      },
      "Orb": {
        "$type": "shadow",
        "$value": {
          "color": "#8B6CFF99",
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "28px",
          "spread": "0px"
        }
      }
    },
    "Elevation": {
      "Sheet": {
        "$type": "shadow",
        "$value": {
          "color": "#00000080",
          "offsetX": "0px",
          "offsetY": "-8px",
          "blur": "32px",
          "spread": "0px"
        }
      },
      "Dialog": {
        "$type": "shadow",
        "$value": {
          "color": "#0000008C",
          "offsetX": "0px",
          "offsetY": "16px",
          "blur": "48px",
          "spread": "0px"
        }
      }
    }
  },
  "gradient": {
    "primary": {
      "$type": "gradient",
      "$value": [
        {
          "color": "#5B3FE6",
          "position": 0
        },
        {
          "color": "#7A4EF2",
          "position": 1
        }
      ]
    },
