          "color": "#4B33C9",
          "position": 0
        },
        {
          "color": "#7A4EF2",
          "position": 1
        }
      ]
    },
    "sky": {
      "$type": "gradient",
      "$value": [
        {
          "color": "#1A1240",
          "position": 0
        },
        {
          "color": "#0B0820",
          "position": 0.55
        },
        {
          "color": "#07051A",
          "position": 1
        }
      ]
    },
    "foil-border": {
      "$type": "gradient",
      "$value": [
