      "$type": "duration"
    },
    "standard": {
      "$value": "300ms",
      "$type": "duration"
    },
    "emphasized": {
      "$value": "450ms",
      "$type": "duration"
    },
    "reveal": {
      "$value": "600ms",
      "$type": "duration"
    },
    "ambient-fast": {
      "$value": "2400ms",
      "$type": "duration"
    },
    "ambient": {
      "$value": "4000ms",
      "$type": "duration"
    },
    "ambient-slow": {
      "$value": "40000ms",
      "$type": "duration"
    }
  },
  "semantic": {
    "primary": {
      "$value": "{color.brand.primary}",
      "$type": "color"
    },
    "on-primary": {
      "$value": "{color.text.on-primary}",
      "$type": "color"
    },
    "secondary": {
      "$value": "{color.brand.link}",
      "$type": "color"
    },
