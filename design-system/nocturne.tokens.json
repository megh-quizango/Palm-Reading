        {
          "color": "#A99BFF1F",
          "position": 1
        }
      ]
    },
    "card": {
      "$type": "gradient",
      "$value": [
        {
          "color": "#2A2066",
          "position": 0
        },
        {
          "color": "#150F38",
          "position": 1
        }
      ]
    },
    "hero-aurora": {
      "$type": "gradient",
      "$value": [
        {
