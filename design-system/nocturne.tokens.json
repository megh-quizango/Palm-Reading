{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "Nocturne design tokens for [AppName] (dark only). Exported from the Figma variables 'Nocturne / Color' and 'Nocturne / Dimension'. Dimensions are Android dp.",
  "color": {
    "bg": {
      "base": {
        "$value": "#0B0820",
        "$type": "color"
      },
      "deep": {
        "$value": "#07051A",
        "$type": "color"
      },
      "raised": {
        "$value": "#1A1240",
        "$type": "color"
      },
      "camera": {
        "$value": "#05040E",
        "$type": "color"
      }
    },
    "surface": {
      "card": {
        "$value": "#1C1645",
        "$type": "color"
      },
      "card-hi": {
        "$value": "#2A2160",
        "$type": "color"
      },
      "scrim": {
        "$value": "#000000",
        "$type": "color"
      }
    },
    "text": {
      "primary": {
        "$value": "#F4F1FF",
        "$type": "color"
      },
      "muted": {
        "$value": "#B4ACDB",
        "$type": "color"
      },
      "on-primary": {
        "$value": "#FFFFFF",
        "$type": "color"
      },
      "on-accent": {
        "$value": "#1A1233",
        "$type": "color"
      }
    },
    "brand": {
      "primary": {
        "$value": "#6A4CF5",
        "$type": "color"
      },
      "primary-deep": {
        "$value": "#5B3FE6",
        "$type": "color"
      },
      "primary-hi": {
        "$value": "#7A4EF2",
        "$type": "color"
      },
      "link": {
        "$value": "#A99BFF",
        "$type": "color"
      }
    },
    "accent": {
